{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enrichment ingest payload",
  "type": "object",
  "properties": {
    "key": { "type": "string", "description": "Echo the leased target record's key exactly." },
    "contact": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "emailBasis": { "type": "string", "enum": ["published", "pattern-guess", "not-found"] },
        "linkedin": { "type": ["string", "null"] },
        "persona": { "type": ["string", "null"] }
      },
      "required": ["name", "title", "email", "emailBasis", "linkedin", "persona"],
      "additionalProperties": false
    },
    "firmographics": {
      "type": "object",
      "properties": {
        "headcount": { "type": ["string", "null"] },
        "revenueBand": { "type": ["string", "null"] },
        "segment": { "type": ["string", "null"] }
      },
      "required": ["headcount", "revenueBand", "segment"],
      "additionalProperties": false
    },
    "hook": { "type": "string" },
    "timingSignal": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "summary": { "type": "string" }
  },
  "required": ["key", "contact", "firmographics", "hook", "timingSignal", "sources", "summary"],
  "additionalProperties": false
}
